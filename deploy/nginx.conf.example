# Merge into the VPS nginx configuration after choosing the real hostname.
# TLS certificate paths must be provisioned by the hosting administrator.
limit_req_zone $binary_remote_addr zone=studio_login:10m rate=5r/m;
server {
    listen 443 ssl;
    server_name studio.example.invalid;
    ssl_certificate /REPLACE/fullchain.pem;
    ssl_certificate_key /REPLACE/privkey.pem;
    client_max_body_size 11m;
    location = /api/auth/login {
        limit_req zone=studio_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
